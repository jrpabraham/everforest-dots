# Everforest Hard — Mako
# ~/.config/mako/config

font=Terminess Nerd Font Regular 12

# Position / dimensions
anchor=bottom-right
width=360
height=120
margin=0
padding=12
border-size=1
border-radius=8

# Colors
background-color=#272e33
text-color=#d3c6aa
border-color=#d3c6aa

# Default notification
default-timeout=5000
ignore-timeout=0

# Grouping
group-by=app-name

# Icons
icons=1
max-icon-size=48

# Text
#format=<b>%s</b>\n%b

# Actions
on-button-left=dismiss
on-button-right=dismiss-all
on-touch=dismiss

# Urgency
[urgency=low]
border-color=#7fbbb3
default-timeout=3000

[urgency=normal]
border-color=#a7c080
default-timeout=5000

[urgency=critical]
border-color=#e67e80
background-color=#2d333b
default-timeout=0

# Volume OSD
[app-name=Volume]
format=<b></b>
background-color=#2d353b
text-color=#2d353b
border-color=#a7c080
progress-color=over #a7c080
border-size=1
border-radius=8
padding=10
default-timeout=1500
