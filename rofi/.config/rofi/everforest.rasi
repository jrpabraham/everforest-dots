* {
    bg:         #1e2326;
    fg:         #d3c6aa;
    green:      #a7c080;
    red:        #e67e80;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 32ch;
    background-color: @bg;
    border: 1px;
    border-color: @green;
    border-radius: 8px;
    padding: 12px 12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 8px;
}

inputbar {
    children: [ entry, num-filtered-rows ];
    spacing: 8px;
}

entry {
    placeholder-color: @fg;
    text-color: @fg;
}

num-filtered-rows {
    text-color: @green;
}

listview {
    lines: 15;
    columns: 1;
    scrollbar: false;
    fixed-height: false;
    spacing: 2px;
}

element {
    padding: 4px 8px;
    spacing: 8px;
    border-radius: 0px;
}

element-icon {
    size: 1.2em;
}

element-text {
    text-color: inherit;
    highlight: bold #a7c080;
}

element selected.normal {
    background-color: @fg;
    text-color: @bg;
    highlight: bold #e67e80;
}