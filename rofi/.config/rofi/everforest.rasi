* {
    bg:         #1e2326;
    fg:         #d3c6aa;
    green:      #a7c080;
    red:        #e67e80;
    dg:         #374145;
    lg:         #9DA9A0;

    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg;
    border-color: @green;
}

inputbar {
    background-color: @dg;
}

entry {
    placeholder-color: @lg;
    text-color: @fg;
}

num-filtered-rows {
    text-color: @lg;
}

element-text {
    highlight: bold #a7c080;
}

element selected.normal {
    background-color: @dg;
    text-color: @fg;
    highlight: bold #e67e80;
}